# Copy to secrets.toml (gitignored) and paste your key. Never commit the real file.
# The usable key starts with sk-ant-api03- and is shown only once, at creation:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = "sk-ant-api03-REPLACE_ME"

# Only if the key is org-scoped rather than created inside a workspace.
# Not a secret, just an identifier. Console -> Settings -> Workspaces.
# ANTHROPIC_WORKSPACE_ID = "wrkspc_..."
